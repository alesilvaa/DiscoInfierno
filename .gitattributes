# Keep Unity YAML assets mergeable and consistent across platforms.
* text=auto
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.controller text eol=lf
*.hlsl text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.physicsMaterial2D text eol=lf
*.prefab text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.txt text eol=lf
*.unity text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary assets. No Git LFS is required while every file remains below 100 MB.
*.aif binary
*.aiff binary
*.bmp binary
*.fbx binary
*.gif binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.ogg binary
*.otf binary
*.pdf binary
*.png binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
*.webm binary
